# Mobile Client Environment Configuration
# Copy this file to `mobile/.env` to customize the backend URL.
#
# IMPORTANT SECURITY NOTICE:
# In Expo / React Native, all EXPO_PUBLIC_* variables are embedded directly into client bundles.
# NEVER place backend secrets, Gemini API keys, SerpApi keys, or private tokens in this file.

# Web browser or iOS Simulator running on host machine:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Android Emulator running on the same host machine (uses special 10.0.2.2 alias):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Physical Device (Phone running Expo Go on the same local Wi-Fi):
# Set this to your computer's local network IP (e.g. run `ipconfig` on Windows or `ifconfig` on Mac/Linux)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
