# ==============================================================================
# Mobile Client Environment Configuration (Expo / React Native)
# Copy this file to `mobile/.env` to customize your backend connection.
#
# IMPORTANT SECURITY NOTICE:
# In Expo / React Native, all `EXPO_PUBLIC_*` variables are embedded directly
# into the client JavaScript bundle and are visible to anyone inspecting the app.
# NEVER place backend secrets, Gemini API keys, SerpApi keys, database passwords,
# or private credentials in this file or any mobile source file.
# The mobile client communicates exclusively with the backend over HTTP/HTTPS.
# ==============================================================================

# Option 1: Production Public Deployment (Render, Cloud, or Custom Domain)
# Point this to your deployed FastAPI backend HTTPS URL (no trailing slash):
EXPO_PUBLIC_API_BASE_URL=https://aura-stylist-backend.onrender.com

# Option 2: Local Web Browser or iOS Simulator on host machine:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Option 3: Local Android Emulator (uses 10.0.2.2 loopback alias to reach host machine):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Option 4: Local Physical Device (Phone running Expo Go on the same local Wi-Fi):
# Set to your computer's LAN IP address (find via `ipconfig` on Windows or `ifconfig` on macOS/Linux):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
