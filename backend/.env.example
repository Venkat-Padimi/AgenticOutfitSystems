# Environment Configuration for AI Personal Outfit Styling & Shopping Agent

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# SerpApi Key for Real Google Shopping India Data (250 free searches/month at https://serpapi.com/)
SERPAPI_API_KEY=your_serpapi_key_here

# Provider Mode: "hybrid" (uses SerpApi if key is present, falls back to fixture if missing or limit reached),
# "live" (strictly live API), or "fixture" (controlled reproducible test datasets for demos)
SHOPPING_PROVIDER_MODE=hybrid

# Agent Safety & Resource Bounds
AGENT_TIMEOUT_SECONDS=60.0
AGENT_MAX_ITERATIONS=6

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=True
