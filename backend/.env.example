# ==============================================================================
# Environment Configuration for Aura Stylist / Agentic Outfit Systems
# DO NOT COMMIT REAL API KEYS OR SENSITIVE CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Reasoning Engine (Google Gemini)
# ------------------------------------------------------------------------------
# Required for real AI agent multi-turn reasoning and tool calling.
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 2. Live E-Commerce Shopping Engine (SerpApi)
# ------------------------------------------------------------------------------
# Powers live product search across Indian e-commerce (Myntra, Flipkart, Amazon, Ajio).
# Obtain a free API key (250 free searches/month) at: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here

# Provider Mode:
# - "hybrid": (Recommended) Uses SerpApi when key is present, falls back safely to controlled fixtures if omitted or exhausted.
# - "live": Strictly uses SerpApi live queries (fails honestly if key is missing or invalid).
# - "fixture": Operates on deterministic local mock catalog without external network calls.
SHOPPING_PROVIDER_MODE=hybrid

# ------------------------------------------------------------------------------
# 3. Agent Safety & Resource Bounds
# ------------------------------------------------------------------------------
AGENT_TIMEOUT_SECONDS=60.0
AGENT_MAX_ITERATIONS=6

# ------------------------------------------------------------------------------
# 4. Server Host, Port & Environment
# ------------------------------------------------------------------------------
# On hosting platforms (e.g. Render, Railway), PORT is dynamically injected by the host.
# Uvicorn binds to 0.0.0.0 to accept external and reverse-proxied traffic.
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ------------------------------------------------------------------------------
# 5. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for web and Expo clients.
# Examples:
# - Local development: http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
# - Production: https://your-app.vercel.app,https://your-custom-domain.com
# - Wildcard: * (allows any origin; note: credentials will be disabled per CORS spec)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Persistent Storage (Blend Group Styling Sessions)
# ------------------------------------------------------------------------------
# Options:
# 1. SQLite (Default): Stored in backend/data/blend.db or under PERSISTENCE_DIR.
# 2. Render Persistent Disk (Paid tiers): Set PERSISTENCE_DIR=/var/data
# 3. Cloud PostgreSQL (Render Free Database, Neon, Supabase):
#    Set DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://user:password@host:5432/aura_db
# PERSISTENCE_DIR=/var/data
